# Kardo Tools environment example
#
# Do not put real secrets in this file.
# Static GitHub Pages cannot read this file directly. These values are intended
# for a future backend, Cloudflare Worker, or deployment pipeline.

# Public site
PUBLIC_SITE_URL=https://tools.songmatin.com

# Cloudflare Worker proxy endpoints
WORKER_RADAR_URL=
WORKER_AQI_URL=
WORKER_WEATHER_PROXY_URL=
WORKER_GEOCODE_PROXY_URL=
WORKER_FLIGHT_PROXY_URL=
WORKER_TIDE_PROXY_URL=

# External service keys
CWA_API_KEY=
AIRLABS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional access control for future backend tools
ADMIN_EMAIL=
ADMIN_ALLOWED_ORIGINS=https://tools.songmatin.com,http://localhost:8000
